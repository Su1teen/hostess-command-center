      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        600
      ],
      "parameters": {
        "jsCode": "return [{ json: { ok: false, needsGuestInput: true, problem: $('Проверка данных').first().json.problem } }];"
      }
