    {
      "id": "0a371d35-2eb2-4b42-9404-1e3d204fbf5e",
      "name": "Command Center: бронь",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Настройки').first().json.ccBaseUrl }}/api/agent/v1/bookings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((() => { const s = $('Старт').first().json; const clean = v => (v === undefined || v === null || String(v).trim() === '' || String(v) === 'null') ? null : String(v).trim();\n  return { chatKey: s.chatKey, idempotencyKey: s.chatKey + ':' + s.messageId + ':' + [s.date, s.time, s.guests].join('/'),\n    jid: clean(s.jid), contactPhone: clean(s.contactPhone)?.replace(/[^+\\d]/g, '').replace(/^8(\\d{10})$/, '+7$1').replace(/^7(\\d{10})$/, '+7$1') || null,\n    name: clean(s.name) || 'Гость', date: clean(s.date), time: clean(s.time)?.padStart(5, '0'), guests: Number(s.guests),\n    zone: clean(s.zone), notes: clean(s.notes) }; })()) }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "16iV4WrEbTKjS0v7",
          "name": "Hostess booking service"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500,
      "onError": "continueRegularOutput"
    },
    {
      "id": "820cb4fe-45a5-48d2-aec8-846fabb0b90b",
      "name": "Итог брони",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "const s = $('Старт').first().json;\nconst cfg = $('Настройки').first().json;\nconst r = $input.first().json || {};\nconst status = Number(r.statusCode || 0);\nconst b = r.body && typeof r.body === 'object' ? r.body : {};\nconst err = b.error || {};\nconst dmy = d => String(d || '').split('-').reverse().join('.');\nconst plural = n => n % 10 === 1 && n % 100 !== 11 ? 'гость' : [2,3,4].includes(n % 10) && ![12,13,14].includes(n % 100) ? 'гостя' : 'гостей';\nconst who = 'Имя: ' + (b.name || s.name) + '\\nТелефон: ' + (b.phone || s.contactPhone || s.jid || s.chatId) + (b.phoneVerified === false ? ' (со слов гостя)' : '');\nconst when = 'Дата: ' + dmy(b.date || s.date) + ' в ' + (b.time || s.time) + '\\nГостей: ' + (b.guests || s.guests);\nconst out = { ok: true, status: 'accepted', groupText: '', telegramText: '', pause: false, pauseReason: '' };\nif (status === 201 && b.status === 'confirmed') {\n  out.status = 'confirmed';\n  out.groupText = (b.replacedPrevious ? '🔄 Бронь изменена гостем (WhatsApp · Даян)\\n' : '✅ Новая бронь (WhatsApp · Даян)\\n') + who + '\\n' + when + '\\nЗона: ' + (b.zoneName || '—') + '\\nМесто: ' + (b.tableName || '—') + (b.notes ? '\\nКомментарий: ' + b.notes : '') + (b.requestedZone && !b.zoneMatched ? '\\n⚠️ Гость хотел: ' + b.requestedZone : '');\n  out.booking = { name: b.name, when: b.when, guests: b.guests, zone: b.zoneName };\n} else if (status === 201 && b.status === 'requested') {\n  out.telegramText = '🕓 Даян: стол не назначился автоматически — заявка в Command Center (Смена → Заявки на бронирование). Назначьте место.\\n' + who + '\\n' + when + (b.requestedZone ? '\\nПожелание: ' + b.requestedZone : '') + '\\nЧат: ' + s.chatId;\n  out.booking = { name: b.name, date: b.date, time: b.time, guests: b.guests };\n} else if (status === 422 && ['CLOSED', 'INVALID_DATE', 'PHONE_REQUIRED', 'INVALID_INPUT'].includes(err.code)) {\n  return [{ json: { ok: false, needsGuestInput: true, problem: err.code === 'CLOSED' ? 'Бронь возможна только на время с 17:00 до 04:00.' : err.code === 'PHONE_REQUIRED' ? 'Нужен номер телефона гостя.' : err.code === 'INVALID_DATE' ? 'Дата уже прошла или слишком далеко — нужна ближайшая будущая дата.' : 'Проверь имя, дату (ГГГГ-ММ-ДД), время (ЧЧ:ММ) и число гостей.' } }];\n} else {\n  out.pause = true;\n  out.pauseReason = 'Бронь не записалась в Command Center';\n  out.telegramText = '🚨 Даян: бронь НЕ записалась в Command Center — внесите вручную. ИИ в этом чате остановлен.\\n' + who + '\\n' + when + (s.zone ? '\\nЗона: ' + s.zone : '') + (s.notes ? '\\nКомментарий: ' + s.notes : '') + '\\nЧат: ' + s.chatId + '\\nОтвет сервера: ' + (status || 'нет ответа') + ' ' + String(err.code || r.error?.message || '').slice(0, 120);\n  out.booking = { name: s.name, date: s.date, time: s.time, guests: s.guests };\n}\nif (cfg.testMode && out.groupText) out.telegramText = [out.telegramText, '🧪 ТЕСТ — в общий чат ушло бы:\\n' + out.groupText].filter(Boolean).join('\\n\\n');\nout.sendGroup = Boolean(out.groupText) && !cfg.testMode && !s.dryRun;\nreturn [{ json: out }];"
      }
    },
