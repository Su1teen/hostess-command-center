    {
      "id": "7063c9c2-1717-4a3c-87ab-e941dfb8d5ea",
      "name": "Проверка уведомлений",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "const out = { ...$('Итог брони').first().json };\nlet group = null; try { group = $('WhatsApp: общий чат').first().json; } catch {}\nif (out.sendGroup && !(group && group.statusCode >= 200 && group.statusCode < 300))\n  out.telegramText = [out.telegramText, '⚠️ Бронь записана, но WhatsApp не принял сообщение в общий чат:\\n' + out.groupText].filter(Boolean).join('\\n\\n');\nreturn [{ json: out }];"
      }
