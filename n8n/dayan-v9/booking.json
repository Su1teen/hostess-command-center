        "jsCode": "const r = $('Проверка уведомлений').first().json;\nif (r.needsGuestInput) return [{ json: { ok: false, needsGuestInput: true, problem: r.problem } }];\nreturn [{ json: { ok: true, status: r.status, booking: r.booking, instruction: 'Бронь стоит. Одним коротким сообщением подтверди гостю: имя, когда (называй время ровно так: «' + (r.booking && r.booking.when) + '»), сколько гостей' + (r.status === 'confirmed' ? ', зона' : '') + ', адрес и ссылка 2ГИС. Условия по деньгам — только если они есть в афише на эту дату.' } }];"
      }
