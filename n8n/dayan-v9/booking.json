    {
      "id": "07c6bcd8-0ed0-4ef3-a632-31faca9e4574",
      "name": "Проверка данных",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        500
      ],
      "parameters": {
        "jsCode": "const s = $('Старт').first().json;\n// The model must not book under the WhatsApp profile name or an invented name.\nconst words = String(s.guestWords || '').toLowerCase();\nconst name = String(s.name || '').trim().toLowerCase();\nconst stem = name.length > 4 ? name.slice(0, name.length - 1) : name;\nconst problem = !name || name === 'гость' ? 'Гость не назвал имя — спроси имя для брони.'\n  : !words.includes(stem) ? 'Гость в переписке не называл имя «' + s.name + '» — спроси, на какое имя оформить бронь.'\n  : !s.date || !s.time || !(Number(s.guests) > 0) ? 'Не хватает даты, времени или числа гостей — уточни у гостя, не придумывай.' : '';\nreturn [{ json: { valid: !problem, problem } }];"
      }
    },
    {
      "id": "efa3e98a-7b86-48b9-9f93-c44e3fcaa020",
      "name": "Данных хватает?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        500
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
