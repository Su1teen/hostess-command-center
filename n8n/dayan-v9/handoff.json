{
  "name": "Даян v9 · 3 · Передать сотруднику",
  "nodes": [
    {
      "id": "af27d44f-b198-4de5-8077-a31cf11e52b9",
      "name": "Старт",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "settings",
              "type": "object"
            },
            {
              "name": "chatKey",
              "type": "string"
            },
            {
              "name": "chatId",
              "type": "string"
            },
            {
              "name": "phone",
              "type": "string"
            },
            {
              "name": "guestName",
              "type": "string"
            },
            {
              "name": "reason",
              "type": "string"
            },
            {
              "name": "summary",
              "type": "string"
            },
            {
              "name": "pause",
              "type": "boolean"
            }
          ]
        }
      }
    },
    {
      "id": "22dae4be-86f5-4f51-986c-c029181de9b8",
      "name": "Настройки",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify($('Старт').first().json.settings) }}",
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "fe0ed11c-6028-49de-8685-cd76ca7e07a5",
      "name": "Остановить ИИ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cff8cfa0-2d2c-4ba2-b2ad-4062673c818a",
              "leftValue": "={{ $('Старт').first().json.pause !== false }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "2ffdb324-13e6-4497-865e-41df1f94da6a",
      "name": "Command Center: остановить ИИ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Настройки').first().json.ccBaseUrl }}/api/agent/v1/handoff",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chatKey: $('Старт').first().json.chatKey, reason: String($('Старт').first().json.reason || 'нужен сотрудник').slice(0, 500) }) }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "16iV4WrEbTKjS0v7",
          "name": "Hostess booking service"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500,
      "onError": "continueRegularOutput"
    },
    {
      "id": "80314081-7032-42c1-a4d3-eb4da1c590cc",
      "name": "Telegram: нужен сотрудник",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "chatId": "={{ $('Настройки').first().json.telegramChatId }}",
        "text": "={{ (() => { const s = $('Старт').first().json; const paused = s.pause !== false; const digits = String(s.phone || s.chatId || '').replace(/\\D/g, ''); return (paused ? '🙋 Даян передал чат сотруднику — ИИ в нём остановлен.\\nПричина: ' : '❓ Гость спросил то, чего Даян не знает. ИИ в чате продолжает отвечать.\\nВопрос: ') + (s.reason || '—') + '\\nСуть: ' + (s.summary || '—') + '\\nГость: ' + (s.guestName || '—') + ' · ' + (s.phone || s.chatId) + (digits.length === 11 ? '\\nНаписать: https://wa.me/' + digits : '') + (paused ? '\\nВернуть ИИ: Command Center → Даян → чат → «Вернуть ИИ».' : ''); })() }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "IstucbElD9VeIe4H",
          "name": "XOXO"
        }
      },
      "onError": "continueRegularOutput",
      "webhookId": "a1b57d9f-9c40-40e4-be92-dd6e608cb100"
    },
    {
      "id": "07e4b63d-55aa-4054-8dc7-4640e4a83833",
      "name": "Ответ агенту",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "const paused = $('Старт').first().json.pause !== false;\nreturn [{ json: { ok: true, instruction: paused\n  ? 'Чат передан администратору. Одной фразой скажи гостю, что администратор скоро ему напишет. Больше ничего не обещай.'\n  : 'Вопрос передан администратору. Скажи гостю одной фразой, что уточнишь это у администратора. Ты продолжаешь отвечать в чате.' } }];"
      }
    }
  ],
  "connections": {
    "Старт": {
      "main": [
        [
          {
            "node": "Настройки",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Настройки": {
      "main": [
        [
          {
            "node": "Остановить ИИ?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Остановить ИИ?": {
      "main": [
        [
          {
            "node": "Command Center: остановить ИИ",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Telegram: нужен сотрудник",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Command Center: остановить ИИ": {
      "main": [
        [
          {
            "node": "Telegram: нужен сотрудник",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram: нужен сотрудник": {
      "main": [
        [
          {
            "node": "Ответ агенту",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Almaty",
    "callerPolicy": "workflowsFromSameOwner",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  }
